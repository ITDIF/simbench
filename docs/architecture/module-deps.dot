// simbench 包级依赖图 —— 由 AST 实测生成，不是按目录结构猜的
//
// 生成日期：2026-10-16　｜　取证基线：git HEAD cbd2322
// 产出流程：architecture-visualization 的 system-modeler + graphviz
//
// 怎么重画（重跑同一段 AST 提取即可，脚本要点见同目录 system-model.md 的「怎么重新生成」）：
//   1. 遍历 simbench/**/*.py，用 ast 取每个文件的 import；
//   2. 相对 import（本项目几乎全用 from ..x）必须按 level 解析回绝对模块名，
//      只扫 level==0 会得到一张空图 —— 这是本图第一次生成时踩到的坑；
//   3. 按「第一层目录名」聚合成包级边；落在函数体内的 import 单独标成 lazy。
//
// 读图口径：
//   实线 = 模块级 import（加载即成立）；虚线 = 函数体内延迟 import（调用时才成立）。
//   颜色 = 分层：橙=界面，蓝=引擎，浅蓝=协议，绿=纯核，红=碰系统状态。
//   G1..G6 = tests/test_architecture.py 里那条守卫（2026-10-16 实测 24 条全绿）。

digraph simbench_package_deps {
    rankdir=TB;
    fontname="Microsoft YaHei";
    fontsize=11;
    labelloc="t";
    label="simbench 包级依赖（AST 实测，HEAD cbd2322）\n实线=模块级 import　虚线=函数体内延迟 import　箭头方向=依赖方向（A→B 读作 A 依赖 B）";
    compound=true;
    nodesep=0.35;
    ranksep=0.6;

    node [fontname="Microsoft YaHei", fontsize=11, shape=box,
          style="rounded,filled", penwidth=1.2];
    edge [fontname="Microsoft YaHei", fontsize=9, color="#555555"];

    // ============ 入口层 ============
    main [label="__main__.py\nCLI 入口 · 485 行\n（对 gui/master/net/project\n全部延迟 import）",
          fillcolor="#E8EAF6", color="#3949AB"];

    // ============ 界面层 ============
    gui [label="gui/\n25 文件 · 4971 行\nPySide6\n─────────\n对 backend 的引用数 = 0（G5）",
         fillcolor="#FFE0B2", color="#E07B00", penwidth=2.0];

    // ============ 引擎层 ============
    engine [label="engine/\n12 文件 · 1775 行\nSession 门面 + EngineRunner\n─────────\n只经门面取 backend（G4）\n不碰 Qt（G2）",
            fillcolor="#BBDEFB", color="#2E6DA4", penwidth=2.0];

    // ============ 协议层 ============
    backend [label="backend/\n11 文件 · 2362 行\nBackendBase + 六种传输\n─────────\npymodbus/pyserial/snap7\n只许住在这里（G1）",
             fillcolor="#CFD8DC", color="#5B7FA6", penwidth=2.0];
    master [label="master/\n4 文件 · 382 行\n主站核对模式 · 只读\n─────────\nG1 为它单开了一个豁免\n（要用 pymodbus 的客户端）",
            fillcolor="#CFD8DC", color="#5B7FA6"];

    // ============ 纯核层 ============
    codec [label="codec/\n4 文件 · 623 行\n纯换算：值↔寄存器 / 波形",
           fillcolor="#C8E6C9", color="#4F7942"];
    project [label="project/\n9 文件 · 2760 行\n领域模型 + 三种文件格式 + 校验\n─────────\n实测不 import 任何内部包\n也不碰 Qt / pymodbus",
             fillcolor="#A5D6A7", color="#2E7D32", penwidth=2.5];

    // ============ 碰系统状态的那一层 ============
    net [label="net/\n12 文件 · 2180 行\n读网卡 · 算差异 · 增删 IP 与虚拟网卡\n─────────\nsubprocess 只许住在这里（G3）\n五个纯模块不许拖进系统层（G6）\n不碰 Qt、不碰 pymodbus",
         fillcolor="#FFCDD2", color="#B3261E", penwidth=2.5];

    // ============ 根下横切 ============
    crosscut [label="根下横切 · 8 文件 · 963 行\nevents（engine↔GUI 的事件契约）\nswallow（吞异常唯一出口）\nsettings · diagnostics\ncsv_io_entry · __about__",
              fillcolor="#E8EAF6", color="#3949AB"];

    // ================= 实测的边 =================
    // gui -> 五处
    gui -> engine   [label="Session 门面\n装载/启停/拉行/订阅"];
    gui -> project  [label="模型 · 校验 · 导入导出"];
    gui -> master   [label="核对页直接调\n（自己的后台线程）", color="#C62828"];
    gui -> net      [label="网络页直接调 startup\n同步跑在 GUI 线程上", color="#C62828"];
    gui -> crosscut [label="订阅 events\n读 settings · 挂 diagnostics"];

    // engine -> 五处
    engine -> backend  [label="只经门面 __init__\n(G4)", penwidth=1.8];
    engine -> codec    [label="写值编码 / 渲染解码"];
    engine -> project  [label="装载 · 校验"];
    engine -> crosscut [label="swallow"];
    engine -> net      [label="endpoints.for_channel\n延迟 import", style=dashed, color="#C62828"];

    // backend -> 三处
    backend -> codec    [label="tick 里算波形 · 钳位 · 编码"];
    backend -> project  [label="模型 + channel_transport()"];
    backend -> crosscut [label="产出 PacketEvent\nChannelState · LogLine"];

    // master -> 两处
    master -> project [label="点表当读取清单"];
    master -> codec   [label="解码后与初值比对\n延迟 import", style=dashed];

    // net -> 一处
    net -> project [label="从点表推设备 IP"];

    // codec -> 一处
    codec -> project [label="只依赖 Point 的形状"];

    // 根下横切 -> 一处
    crosscut -> project [label="csv_io_entry 复用\nformats / model / validate"];

    // __main__ 全部延迟 import（CLI 冷启动不被 Qt 与协议库拖慢）
    main -> gui      [style=dashed, label="只有 --gui 时才加载"];
    main -> master   [style=dashed, label="--scan / --verify"];
    main -> net      [style=dashed, label="net 子命令"];
    main -> project  [style=dashed];
    main -> crosscut [style=dashed];

    // ================= 图例 =================
    subgraph cluster_legend {
        label="分层守卫（tests/test_architecture.py，2026-10-16 实测 24 条全绿）";
        fontname="Microsoft YaHei"; fontsize=10;
        style="dashed"; color="#888888";
        node [shape=plaintext, fillcolor="#FFFFFF", style="", fontname="Consolas", fontsize=9];
        legend [label=<
          <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2" ALIGN="LEFT">
            <TR><TD ALIGN="LEFT"><B>G1</B> pymodbus / serial / snap7 只许出现在 backend/ 与 master/</TD></TR>
            <TR><TD ALIGN="LEFT"><B>G2</B> PySide6 / PyQt5 只许出现在 gui/</TD></TR>
            <TR><TD ALIGN="LEFT"><B>G3</B> subprocess 只许出现在 net/</TD></TR>
            <TR><TD ALIGN="LEFT"><B>G4</B> engine/ 只许经 backend/__init__.py 门面取后端，不许摸实现文件</TD></TR>
            <TR><TD ALIGN="LEFT"><B>G5</B> gui/ 对 backend 的引用数必须是 0（连门面也不许）</TD></TR>
            <TR><TD ALIGN="LEFT"><B>G6</B> net/ 的五个纯模块运行时不许 import ctypes / subprocess / state</TD></TR>
            <TR><TD ALIGN="LEFT"> </TD></TR>
            <TR><TD ALIGN="LEFT">每条守卫都另配一条「植入样本必须被抓」的用例，防止守卫空跑。</TD></TR>
            <TR><TD ALIGN="LEFT">红线 = 绕过 engine 门面、由上层直接调下层实现的那几条边。</TD></TR>
          </TABLE>
        >];
    }
}
